# Model to download and run from Hugging Face / local directory
MODEL_NAME=mlx-community/Qwen2.5-3B-Instruct-4bit

# Server Address Options
HOST=127.0.0.1
PORT=8000

# Default Inference Parameters
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048

# Continuous Dynamic Batching Options
BATCHING_WINDOW_MS=25
MAX_BATCH_SIZE=16

# Security Options (Optional: leave blank to disable authentication)
API_KEY=
ADMIN_PASSWORD=admin123

# Observability Settings
LOGGING_LEVEL=INFO
METRICS_ENABLED=true

# Model Pricing Options (cost in USD per 1,000,000 tokens)
PRICE_PER_1M_INPUT_TOKENS=0.15
PRICE_PER_1M_OUTPUT_TOKENS=0.60
PRICE_PER_1M_CACHED_TOKENS=0.075
